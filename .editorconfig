[*]
end_of_line               = lf
indent_size               = 2
indent_style              = space
insert_final_newline      = true
trim_trailing_whitespace  = true

[*.{sh,zsh}]
binary_next_line    = true
function_next_line  = false
keep_padding        = true
minify              = false
never_split         = true
simplify            = false
space_redirects     = true
switch_case_indent  = true

[*.sh]
shell_variant      = bash

[*.zsh]
shell_variant      = zsh
